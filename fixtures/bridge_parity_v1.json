{
  "protocolVersion": 1,
  "cases": [
    {
      "name": "meters to kilometers",
      "value": "1500",
      "fromUnitId": "meter",
      "toUnitId": "kilometer",
      "decimalPlaces": 12,
      "roundMode": "nearestEven",
      "expected": "1.5"
    },
    {
      "name": "kilometers to meters",
      "value": "1.5",
      "fromUnitId": "kilometer",
      "toUnitId": "meter",
      "decimalPlaces": 12,
      "roundMode": "nearestEven",
      "expected": "1500"
    },
    {
      "name": "celsius freezing point to fahrenheit",
      "value": "0",
      "fromUnitId": "celsius",
      "toUnitId": "fahrenheit",
      "decimalPlaces": 12,
      "roundMode": "nearestEven",
      "expected": "32"
    },
    {
      "name": "hours to seconds",
      "value": "1",
      "fromUnitId": "hour",
      "toUnitId": "second",
      "decimalPlaces": 12,
      "roundMode": "nearestEven",
      "expected": "3600"
    },
    {
      "name": "kibibyte to byte",
      "value": "1",
      "fromUnitId": "kibibyte",
      "toUnitId": "byte",
      "decimalPlaces": 12,
      "roundMode": "nearestEven",
      "expected": "1024"
    },
    {
      "name": "nearest even positive tie",
      "value": "2.5",
      "fromUnitId": "meter",
      "toUnitId": "meter",
      "decimalPlaces": 0,
      "roundMode": "nearestEven",
      "expected": "2"
    },
    {
      "name": "half away positive tie",
      "value": "2.5",
      "fromUnitId": "meter",
      "toUnitId": "meter",
      "decimalPlaces": 0,
      "roundMode": "halfAwayFromZero",
      "expected": "3"
    },
    {
      "name": "toward zero negative value",
      "value": "-2.9",
      "fromUnitId": "meter",
      "toUnitId": "meter",
      "decimalPlaces": 0,
      "roundMode": "towardZero",
      "expected": "-2"
    },
    {
      "name": "away from zero negative value",
      "value": "-2.1",
      "fromUnitId": "meter",
      "toUnitId": "meter",
      "decimalPlaces": 0,
      "roundMode": "awayFromZero",
      "expected": "-3"
    },
    {
      "name": "floor positive sub-centimeter kilometer result",
      "value": "1",
      "fromUnitId": "meter",
      "toUnitId": "kilometer",
      "decimalPlaces": 2,
      "roundMode": "floor",
      "expected": "0"
    },
    {
      "name": "ceiling positive sub-centimeter kilometer result",
      "value": "1",
      "fromUnitId": "meter",
      "toUnitId": "kilometer",
      "decimalPlaces": 2,
      "roundMode": "ceiling",
      "expected": "0.01"
    },
    {
      "name": "floor negative value",
      "value": "-2.1",
      "fromUnitId": "meter",
      "toUnitId": "meter",
      "decimalPlaces": 0,
      "roundMode": "floor",
      "expected": "-3"
    },
    {
      "name": "ceiling negative value",
      "value": "-2.1",
      "fromUnitId": "meter",
      "toUnitId": "meter",
      "decimalPlaces": 0,
      "roundMode": "ceiling",
      "expected": "-2"
    }
  ]
}
